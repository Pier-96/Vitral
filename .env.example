DATABASE_URL="file:./gym-progress.db"
PORT=3001
# Ubicación en otro volumen, NAS montado o carpeta sincronizada de tu nube personal.
# Ejemplo macOS: BACKUP_DIR="/Volumes/MiDiscoExterno/GymProgress-backups"
BACKUP_DIR=""
# Token largo y secreto para la aplicación puente de Apple Health.
HEALTH_WEBHOOK_TOKEN=""
# Cliente (seguras de exponer en el navegador):
VITE_SUPABASE_URL="https://tu-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Servidor: usa los mismos valores, sin service_role para validar sesiones.
SUPABASE_URL="https://tu-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Solo para desarrollo local sin Supabase. No activar en producción.
ALLOW_LOCAL_AUTH="true"
# UUID del usuario de Supabase que posee el token del webhook Apple Health.
HEALTH_WEBHOOK_USER_ID=""
# Solo para la migración local a Supabase. Nunca exponer en Vite ni Git.
POSTGRES_DATABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="hhe"
MIGRATION_USER_ID=""
